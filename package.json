{
  "name": "ringo-productions",
  "version": "1.0.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run dev:css\" \"node --watch server.js\"",
    "dev:css": "npx @tailwindcss/cli -i ./public/src/tailwind.css -o ./public/src/output.css --watch",
    "build:css": "npx @tailwindcss/cli -i ./public/src/tailwind.css -o ./public/src/output.css --minify"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "concurrently": "^10.0.4",
    "tailwindcss": "^4.0.0"
  }
}
